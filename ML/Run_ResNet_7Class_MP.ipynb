{
  "cells": [
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# ResNet 학습/비교 실행 노트북\n",
        "이 노트북은 `.py` 학습 스크립트를 실행하고, 2클래스 vs 7클래스 `history`를 같은 포맷으로 시각화합니다."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# 0) 커널 체크 + 필수 패키지 설치\n",
        "import sys, subprocess, importlib.util\n",
        "from pathlib import Path\n",
        "\n",
        "BASE = Path(r\"c:\\\\Users\\\\ldy34\\\\Desktop\\\\Face\")\n",
        "ML = BASE / \"ML\"\n",
        "\n",
        "print(\"Current Python:\", sys.executable)\n",
        "if \"Face\\\\.venv\\\\Scripts\\\\python.exe\" not in sys.executable.replace('/', '\\\\'):\n",
        "    raise RuntimeError(\n",
        "        \"현재 커널이 프로젝트 .venv가 아닙니다. Kernel -> Change Kernel에서 c:/Users/ldy34/Desktop/Face/.venv/Scripts/python.exe 선택 후 다시 실행하세요.\"\n",
        "    )\n",
        "\n",
        "required = [\"matplotlib\", \"cv2\", \"mediapipe\", \"torch\", \"sklearn\", \"tqdm\"]\n",
        "missing = []\n",
        "for m in required:\n",
        "    name = \"opencv_python\" if m == \"cv2\" else (\"scikit_learn\" if m == \"sklearn\" else m)\n",
        "    if importlib.util.find_spec(m) is None:\n",
        "        missing.append(name)\n",
        "\n",
        "if missing:\n",
        "    print(\"Installing missing packages:\", missing)\n",
        "    # mediapipe는 프로젝트 권장 버전 고정\n",
        "    pkgs = []\n",
        "    for p in missing:\n",
        "        if p == \"mediapipe\":\n",
        "            pkgs.append(\"mediapipe==0.10.14\")\n",
        "        elif p == \"opencv_python\":\n",
        "            pkgs.append(\"opencv-python\")\n",
        "        elif p == \"scikit_learn\":\n",
        "            pkgs.append(\"scikit-learn\")\n",
        "        else:\n",
        "            pkgs.append(p)\n",
        "    subprocess.check_call([sys.executable, \"-m\", \"pip\", \"install\", *pkgs])\n",
        "    print(\"Install done. 커널 재시작 후 다시 실행하세요.\")\n",
        "else:\n",
        "    print(\"All required packages are available in this kernel.\")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# 1) 경로/파일 설정\n",
        "from pathlib import Path\n",
        "\n",
        "BASE = Path(r\"c:\\\\Users\\\\ldy34\\\\Desktop\\\\Face\")\n",
        "ML = BASE / \"ML\"\n",
        "VENV_PY = BASE / \\".venv\\" / \\"Scripts\\" / \\"python.exe\\"\n",
        "\n",
        "TRAIN_7_PY = ML / \"train_resnet_7class_mp.py\"\n",
        "TRAIN_2_PY = ML / \"train_resnet_2class_mp.py\"\n",
        "\n",
        "BIN_MODEL = ML / \"emotion_resnet_best.pth\"\n",
        "BIN_HIST = ML / \"emotion_resnet_best_history.json\"\n",
        "\n",
        "MC_MODEL = ML / \"emotion_resnet_7class_best.pth\"\n",
        "MC_HIST = ML / \"emotion_resnet_7class_best_history.json\"\n",
        "\n",
        "print(\"Python:\", VENV_PY)\n",
        "print(\"ML dir:\", ML)\n",
        "print(\"7-class trainer exists:\", TRAIN_7_PY.exists())\n",
        "print(\"2-class trainer exists:\", TRAIN_2_PY.exists())"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# 2) 7클래스 학습 실행 (.py)\n",
        "import subprocess\n",
        "\n",
        "cmd7 = [\n",
        "    str(VENV_PY), str(TRAIN_7_PY),\n",
        "    \"--base-dir\", str(BASE / \"video\"),\n",
        "    \"--epochs\", \"200\",\n",
        "    \"--batch-size\", \"256\",\n",
        "    \"--lr\", \"0.001\",\n",
        "    \"--test-size\", \"0.15\",\n",
        "    \"--max-per-zip\", \"5000\",\n",
        "    \"--workers\", \"8\",\n",
        "    \"--out\", str(MC_MODEL),\n",
        "]\n",
        "\n",
        "print(\"RUN:\", \" \\".join(cmd7))\n",
        "res7 = subprocess.run(cmd7, cwd=str(BASE), check=True)\n",
        "print(\"7-class done:\", res7)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# 3) (선택) 2클래스 history가 없으면 메시지 출력\n",
        "if not BIN_HIST.exists():\n",
        "    print(\"emotion_resnet_best_history.json 이 없습니다.\")\n",
        "    print(\"옵션 A) train_resnet_2class_mp.py를 만든 뒤 동일 방식으로 학습\")\n",
        "    print(\"옵션 B) Emotion_Training_ResNet.ipynb의 history를 json으로 저장\")\n",
        "else:\n",
        "    print(\"2-class history found:\", BIN_HIST)\n",
        "\n",
        "print(\"7-class history found:\", MC_HIST.exists(), MC_HIST)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# 4) 비교 플롯 (2-class history가 있을 때)\n",
        "import json\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "if not BIN_HIST.exists():\n",
        "    raise FileNotFoundError(f\"2-class history 없음: {BIN_HIST}\")\n",
        "if not MC_HIST.exists():\n",
        "    raise FileNotFoundError(f\"7-class history 없음: {MC_HIST}\")\n",
        "\n",
        "with open(BIN_HIST, \"r\", encoding=\"utf-8\") as f:\n",
        "    history_bin = json.load(f)\n",
        "\n",
        "with open(MC_HIST, \"r\", encoding=\"utf-8\") as f:\n",
        "    history_7 = json.load(f)\n",
        "\n",
        "plt.figure(figsize=(18, 10))\n",
        "\n",
        "# 2-class\n",
        "plt.subplot(2, 3, 1)\n",
        "plt.plot(history_bin['train_loss'], label='Train')\n",
        "plt.plot(history_bin['test_loss'], label='Val')\n",
        "plt.title('2-Class Loss')\n",
        "plt.legend(); plt.grid(True)\n",
        "\n",
        "plt.subplot(2, 3, 2)\n",
        "plt.plot(history_bin['train_acc'], label='Train')\n",
        "plt.plot(history_bin['test_acc'], label='Val')\n",
        "plt.title('2-Class Accuracy')\n",
        "plt.legend(); plt.grid(True)\n",
        "\n",
        "plt.subplot(2, 3, 3)\n",
        "plt.plot(history_bin['lr'], color='red')\n",
        "plt.title('2-Class Learning Rate')\n",
        "plt.grid(True)\n",
        "\n",
        "# 7-class\n",
        "plt.subplot(2, 3, 4)\n",
        "plt.plot(history_7['train_loss'], label='Train')\n",
        "plt.plot(history_7['test_loss'], label='Val')\n",
        "plt.title('7-Class Loss')\n",
        "plt.legend(); plt.grid(True)\n",
        "\n",
        "plt.subplot(2, 3, 5)\n",
        "plt.plot(history_7['train_acc'], label='Train')\n",
        "plt.plot(history_7['test_acc'], label='Val')\n",
        "plt.title('7-Class Accuracy')\n",
        "plt.legend(); plt.grid(True)\n",
        "\n",
        "plt.subplot(2, 3, 6)\n",
        "plt.plot(history_7['lr'], color='red')\n",
        "plt.title('7-Class Learning Rate')\n",
        "plt.grid(True)\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ]
    }
  ],
